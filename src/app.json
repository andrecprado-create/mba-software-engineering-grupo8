{
  "expo": {
    "name": "EmpCol",
    "slug": "empcol",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.grupo8.empcol"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.grupo8.empcol",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "O EmpCol usa suas fotos para ler a capa da edição.",
          "cameraPermission": "O EmpCol usa a câmera para fotografar a capa da edição.",
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "empcol",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "2a33faa1-5d79-465f-bb9f-29bf0fe1d526"
      }
    },
    "owner": "andre.cprado"
  }
}
