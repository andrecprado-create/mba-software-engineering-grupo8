# Copie para .env.local e preencha. Nunca versione valores reais (AGENTS.md).

# Só no back-end (Netlify > Site configuration > Environment variables):
GEMINI_API_KEY=
# Opcional; padrão gemini-2.5-flash
GEMINI_MODEL=

# Só para rodar no celular (Expo Go): endereço público do site na Netlify, sem barra no fim.
EXPO_PUBLIC_API_URL=
