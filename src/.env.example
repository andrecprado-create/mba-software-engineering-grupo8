# Copie para .env.local e preencha. Nunca versione valores reais (AGENTS.md).

# Back-end. Na Netlify, o AI Gateway injeta GEMINI_API_KEY e GOOGLE_GEMINI_BASE_URL sozinho (ADR 0004).
# Fora da Netlify, use uma chave do Google AI Studio e deixe GOOGLE_GEMINI_BASE_URL vazio.
GEMINI_API_KEY=
GOOGLE_GEMINI_BASE_URL=
# Opcional; padrão gemini-3.8-flash
GEMINI_MODEL=

# Só para rodar no celular (Expo Go): endereço público do site, sem barra no fim.
EXPO_PUBLIC_API_URL=https://empcol.netlify.app
